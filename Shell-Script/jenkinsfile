pipeline {
    agent any 

    stages {
        stage('checkout'){
            steps {
                git branch: 'master',
                    url: 'https://github.com/Ramya20041110/DemoRepo01'
            }
        }
        stage('build') {
            steps {
                sh 'chmod +x Health-Monitor.sh'
                sh './Health-Monitor.sh'
            }
        }
    }
}
